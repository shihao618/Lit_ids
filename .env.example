# ===== 首次初始化（之后所有配置都在后台 /admin 管理） =====
# 首次启动会用下面的信息创建第一个管理员用户（用户表为空时）：
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# 管理员初始 API Key（不填会自动生成，可在后台「我的账号 / API Key」查看或重置）
API_KEY=change-me-to-a-long-random-string

# ===== 部署基础设施（其余配置都在后台「系统设置」里改） =====
# 数据目录：users.json / sessions/ / settings.json / .gateway_secret 都放在这里
# 容器内由 docker-compose.yml 固定为 /data
# DATA_DIR=data

# 可选：后台 cookie 签名密钥（不填自动生成并保存到 <DATA_DIR>/.gateway_secret）
# ADMIN_SECRET=

# 说明：以下配置已迁移到后台「系统设置」（保存到 <DATA_DIR>/settings.json）：
#   - 系统名称 app_name
#   - 日志级别 log_level
#   - 会话保活间隔 session_refresh_interval
#   - 启动时自动登录 auto_login_on_start（修改后需在后台点「重启容器」）
